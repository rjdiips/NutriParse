# AI provider: "openrouter" (default) or "local".
LLM_PROVIDER=openrouter

# Local OpenAI-compatible server, used when LLM_PROVIDER=local.
# Ollama: http://localhost:11434/v1 | LM Studio: http://localhost:1234/v1
# llama.cpp: http://localhost:8080/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:9b
# Only needed if your local server requires a key.
# LLM_API_KEY=
# Optional request timeout in seconds. OpenRouter defaults: 30 (nutrition),
# 45 (recipes). Local default: 180.
# LLM_TIMEOUT=
# Thinking models can spend minutes before emitting content. "none" disables
# reasoning; leave empty to use the server default. Set LLM_JSON_MODE=false if
# your local server rejects response_format.
# LLM_REASONING_EFFORT=none
# LLM_JSON_MODE=true

# OpenRouter settings, used when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local recipe images (OpenVINO service).
LOCAL_IMAGE_API_URL=http://127.0.0.1:7860/sdapi/v1/txt2img
LOCAL_IMAGE_GENERATION_ENABLED=true

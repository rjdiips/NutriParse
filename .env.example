# AI provider: "openrouter" (default) or "local".
LLM_PROVIDER=openrouter

# Local serving, used when LLM_PROVIDER=local. Any OpenAI-compatible
# /chat/completions endpoint works; the default below is Ollama.
#   Ollama:    http://localhost:11434/v1
#   llama.cpp: http://localhost:8080/v1   (start_llm.bat)
#   LM Studio: http://localhost:1234/v1
LLM_BASE_URL=http://localhost:11434/v1
# Label shown in the inspector and logs. With Ollama use the pulled tag.
LLM_MODEL=qwen3.5:4b
# Only needed if your local server requires a key.
# LLM_API_KEY=
# Optional request timeout in seconds. OpenRouter defaults: 30 (nutrition),
# 45 (recipes). Local default: 180.
# LLM_TIMEOUT=
# Sent as reasoning_effort when non-empty; set "none" to disable reasoning.
# LLM_REASONING_EFFORT=none
# JSON mode via response_format; set false if your Ollama build rejects it.
# LLM_JSON_MODE=true

# OpenRouter settings, used when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local recipe images: any AUTOMATIC1111-compatible /sdapi/v1/txt2img endpoint.
# The CUDA image service (start_image_generator.bat) uses port 7860.
LOCAL_IMAGE_API_URL=http://127.0.0.1:7860/sdapi/v1/txt2img
LOCAL_IMAGE_GENERATION_ENABLED=true
# SDXL-Turbo needs ~6 steps; SD 1.5 typically uses 20.
LOCAL_IMAGE_STEPS=6
# 4:3 matches the .recipe__media frame in compose.css, so the generated
# image is not cropped by object-fit: cover.
LOCAL_IMAGE_WIDTH=640
LOCAL_IMAGE_HEIGHT=480
